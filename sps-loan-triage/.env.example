# Public port for the FastAPI web application
APP_PORT=8080

# Ollama models pulled by the initialization container
OLLAMA_PRIMARY_MODEL=phi4-mini
OLLAMA_FALLBACK_MODEL=gemma3:2b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Increase this value on slower CPU-only servers
OLLAMA_TIMEOUT_SECONDS=120

# Optional self-hosted LangFuse configuration
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
